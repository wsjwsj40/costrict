{
	"name": "dicode-codex",
	"displayName": "DiCode",
	"description": "DiCode coding agent powered by the unmodified Codex CLI",
	"version": "0.2.38",
	"publisher": "atad-apts",
	"repository": {
		"type": "git",
		"url": "https://github.com/wsjwsj40/costrict"
	},
	"engines": {
		"vscode": "^1.93.1"
	},
	"categories": [
		"AI"
	],
	"activationEvents": [
		"onView:dicodeCodex.sidebar"
	],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dicodeCodex",
					"title": "DiCode",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"dicodeCodex": [
				{
					"type": "webview",
					"id": "dicodeCodex.sidebar",
					"name": "DiCode"
				}
			]
		},
		"configuration": {
			"title": "DiCode",
			"properties": {
				"dicodeCodex.serverUrl": {
					"type": "string",
					"default": "https://dicode.byd.com:30092",
					"description": "DiCode API entry URL"
				},
				"dicodeCodex.codexPath": {
					"type": "string",
					"default": "codex",
					"description": "Path to the installed Codex CLI"
				},
				"dicodeCodex.windowsSandboxFallback": {
					"type": "string",
					"enum": [
						"unelevated",
						"elevated"
					],
					"default": "unelevated",
					"description": "Codex Windows sandbox fallback when MXC is unavailable. Elevated requires administrator provisioning; unelevated has weaker network isolation."
				}
			}
		}
	},
	"scripts": {
		"build": "vite build",
		"vscode:prepublish": "npm run build",
		"test": "npm run build && node --test test/*.test.js",
		"check": "tsc --project tsconfig.json --noEmit && node --check extension.js && node --check fileEditTools.js && node --check media/conversation.js"
	},
	"files": [
		"extension.js",
		"threadTitle.js",
		"codexInstaller.js",
		"powerShellInstaller.js",
		"diff.js",
		"fileEditTools.js",
		"unifiedDiff.js",
		"dicode-instructions.md",
		"file-edit-instructions.md",
		"media/**",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vscode/vsce": "^4.1.0",
		"jsdom": "^29.1.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.8"
	}
}
