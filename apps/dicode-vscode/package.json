{
	"name": "dicode-codex",
	"displayName": "DiCode",
	"description": "DiCode coding agent powered by the unmodified Codex CLI",
	"version": "0.2.18",
	"publisher": "atad-apts",
	"repository": {
		"type": "git",
		"url": "https://github.com/wsjwsj40/costrict"
	},
	"engines": {
		"vscode": "^1.93.1"
	},
	"categories": [
		"AI"
	],
	"activationEvents": [
		"onView:dicodeCodex.sidebar"
	],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dicodeCodex",
					"title": "DiCode",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"dicodeCodex": [
				{
					"type": "webview",
					"id": "dicodeCodex.sidebar",
					"name": "DiCode"
				}
			]
		},
		"configuration": {
			"title": "DiCode",
			"properties": {
				"dicodeCodex.serverUrl": {
					"type": "string",
					"default": "https://dicode.byd.com:30092",
					"description": "DiCode API entry URL"
				},
				"dicodeCodex.codexPath": {
					"type": "string",
					"default": "codex",
					"description": "Path to the installed Codex CLI"
				},
				"dicodeCodex.windowsSandboxFallback": {
					"type": "string",
					"enum": ["unelevated", "elevated"],
					"default": "unelevated",
					"description": "Codex Windows sandbox fallback when MXC is unavailable. Elevated requires administrator provisioning; unelevated has weaker network isolation."
				}
			}
		}
	},
	"scripts": {
		"build": "esbuild media/main.js --bundle --platform=browser --format=iife --outfile=media/bundle.js --minify",
		"vscode:prepublish": "npm run build",
		"test": "npm run build && node --test test/*.test.js",
		"check": "node --check extension.js && node --check threadTitle.js && node --check codexInstaller.js && node --check powerShellInstaller.js && node --check diff.js && node --check media/conversation.js && node --check media/main.js"
	},
	"files": [
		"extension.js",
		"threadTitle.js",
		"codexInstaller.js",
		"powerShellInstaller.js",
		"diff.js",
		"dicode-instructions.md",
		"media/**",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"esbuild": "^0.28.2",
		"highlight.js": "^11.12.0",
		"markdown-it": "^15.0.3"
	},
	"devDependencies": {
		"@vscode/vsce": "^4.1.0",
		"jsdom": "^29.1.1"
	}
}
